# 依赖
node_modules/

# 构建产物
dist/
unpackage/

# 环境变量（真实密钥不入库）
.env
.env.local
.env.*.local

# 本地数据库（用 npm run prisma:seed 重建）
*.db
*.db-journal
*.sqlite

# 运行时上传的文件（本地存储降级方案）
backend/uploads/*
!backend/uploads/.gitkeep

# 数据库 schema 备份
*.bak

# 日志
*.log
npm-debug.log*

# 编辑器
.vscode/
.idea/
.DS_Store

# 工作区内部数据（会话记忆等，非项目代码）
.workbuddy/
