# 服务
PORT=3000
NODE_ENV=development

# 数据库
DATABASE_URL="file:./dev.db"

# Redis（当前未启用，预留）
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=change-me-to-a-secret
JWT_EXPIRES_IN=2h

# CORS（逗号分隔）
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# 微信小程序（留空时 /auth/wx-login 走本地降级模式，不请求微信服务器）
WECHAT_APPID=
WECHAT_SECRET=

# 对象存储（OSS/COS，留空时上传落到本地 backend/uploads）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=
