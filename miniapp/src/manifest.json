{
  "name": "途记 TravelJournal",
  "appid": "",
  "description": "把走过的路 变成自己的故事",
  "versionName": "1.4.0",
  "versionCode": "104",
  "transformPx": false,
  "app-plus": {
    "usingComponents": true,
    "nvueStyleCompiler": "uni-app",
    "compilerVersion": 3,
    "splashscreen": {
      "alwaysShowBeforeRender": true,
      "waiting": true,
      "autoclose": true,
      "delay": 0
    },
    "modules": {},
    "distribute": {
      "android": {
        "permissions": [
          "<uses-permission android:name=\"android.permission.INTERNET\"/>",
          "<uses-permission android:name=\"android.permission.ACCESS_NETWORK_STATE\"/>"
        ]
      },
      "ios": {},
      "sdkConfigs": {}
    }
  },
  "quickapp": {},
  "mp-weixin": {
    "appid": "",
    "setting": {
      "urlCheck": false,
      "es6": true,
      "postcss": true,
      "minified": true
    },
    "usingComponents": true,
    "permission": {
      "scope.userLocation": {
        "desc": "用于记录旅行足迹位置"
      }
    },
    "requiredPrivateInfos": ["getLocation", "chooseLocation"]
  },
  "mp-alipay": {
    "usingComponents": true
  },
  "h5": {
    "title": "途记 TravelJournal",
    "router": {
      "mode": "hash"
    }
  },
  "vueVersion": "3"
}
